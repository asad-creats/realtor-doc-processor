# Copy to .env (local) or set these as secrets on your cloud host.

# Which hosted provider to use: groq | openrouter | openai
AI_PROVIDER=groq

# API key for the chosen provider (only the matching one is required).
GROQ_API_KEY=your-groq-key-here
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# Optional: override the model id (defaults are sensible per provider).
# AI_MODEL=llama-3.3-70b-versatile

# Optional: port for the web app (cloud hosts usually set this for you).
# PORT=7860
